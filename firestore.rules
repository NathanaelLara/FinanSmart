rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validCurrency(value) {
      return value in ['DOP', 'USD'];
    }

    function validTransactionType(value) {
      return value in ['income', 'expense'];
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isOwner(userId) && request.resource.data.id == resource.data.id;
    }

    match /transactions/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && validTransactionType(request.resource.data.type)
        && validCurrency(request.resource.data.currency)
        && request.resource.data.amount > 0;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && validTransactionType(request.resource.data.type)
        && validCurrency(request.resource.data.currency)
        && request.resource.data.amount > 0;
    }

    match /budgets/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && validCurrency(request.resource.data.currency);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && validCurrency(request.resource.data.currency);
    }

    match /financial_products/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /monthly_reports/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }

    match /categories/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && validTransactionType(request.resource.data.type);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && validTransactionType(request.resource.data.type);
    }

    match /financial_health/{docId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }
  }
}
